{
	"locale": "und",
	"format": "%organization\n%recipient\n%addressLine1\n%addressLine2\n%administrativeArea\n%postalCode %locality",
	"required_fields": [
		"recipient",
		"addressLine1",
		"locality",
		"postalCode"
	],
	"uppercase_fields": [
		"locality"
	],
	"administrative_area_type": "region",
	"locality_type": "city",
	"postal_code_type": "postal",
	"postal_code_pattern": "\\d{4}"
}