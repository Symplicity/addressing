{
	"locale": "und",
	"format": "%recipient\n%organization\n%addressLine1\n%addressLine2\n%administrativeArea\n%postalCode %locality",
	"required_fields": [
		"recipient",
		"addressLine1",
		"locality",
		"administrativeArea"
	],
	"uppercase_fields": [
		"locality",
		"administrativeArea"
	],
	"locality_type": "city",
	"administrative_area_type": "state",
	"postal_code_type": "postal",
	"postal_code_pattern": "\\d{4,5}"
}